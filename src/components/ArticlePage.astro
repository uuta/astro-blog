---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { article } from '../i18n/article';
import { home } from '../i18n/home';
import { localeUrl, otherLang } from '../i18n/ui';
import { findTranslation, formatDate, keyedPostUrl, postUrl, type Post } from '../lib/writing';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { lang } = post.data;
const t = article[lang];
const { Content } = await render(post);

// Without a translation, both language links fall back to the other home's Writing list.
const translation = await findTranslation(post);
const otherHref = translation ? postUrl(translation) : `${localeUrl(otherLang(lang))}#writing`;

// "Next" follows the order of the Writing list on the home page.
const rows = home[lang].writing.rows;
const index = post.data.key ? rows.findIndex((row) => row.post === post.data.key) : -1;
const nextRow = index >= 0 ? rows[index + 1] : undefined;
const next = nextRow && {
	title: nextRow.title,
	href: nextRow.post ? await keyedPostUrl(nextRow.post, lang) : '#',
};
---

<Base
	lang={lang}
	title={`${post.data.title} — uuta`}
	description={post.data.description}
	counterpart={{ href: otherHref, translated: Boolean(translation) }}
	current="writing"
>
	<main>
		<article class="wrap article">
			<a class="back mono" href={`${localeUrl(lang)}#writing`}><Icon name="arrow-left" size={14} />{t.allWriting}</a>
			{post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
			<h1>{post.data.title}</h1>
			<div class="meta mono">
				<span>{formatDate(post.data.date)}</span>
				<span>{t.readingTime}</span>
				<a class="other" href={otherHref} hreflang={otherLang(lang)} lang={otherLang(lang)}>{t.readInOther}</a>
			</div>

			<div class="how">
				<p class="meta-label">{t.howTitle}</p>
				<p class="how-body">{t.howBody}</p>
			</div>

			<div class="prose">
				<Content />
			</div>

			{
				next && (
					<div class="next">
						<p class="meta-label">{t.next}</p>
						<a href={next.href}>
							{next.title}
							<Icon name="arrow-right" />
						</a>
					</div>
				)
			}

			<div class="strip">
				<p>{t.cta}</p>
				<a class="btn btn--on-strip" href={`${localeUrl(lang)}#contact`}>{t.ctaButton}</a>
			</div>
		</article>
	</main>
</Base>

<style>
	.article {
		max-width: 720px;
		padding-top: 80px;
		padding-bottom: 64px;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 13px;
		color: var(--muted);
		text-decoration: none;
	}
	.tags {
		margin-top: 24px;
	}
	h1 {
		margin: 20px 0 0;
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 600;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 24px;
		margin-top: 24px;
		font-size: 14px;
		color: var(--muted);
	}
	.other,
	.other:hover {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		color: var(--accent);
		text-decoration: none;
	}
	.how {
		margin-top: 32px;
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 20px 24px;
		background: var(--soft);
	}
	.how-body {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--body);
	}

	/* Markdown body */
	.prose {
		margin-top: 40px;
	}
	.prose > :global(*) {
		margin: 0;
	}
	.prose > :global(p) {
		margin-top: 24px;
		font-size: 19px;
		line-height: 1.75;
	}
	.prose > :global(:first-child) {
		margin-top: 0;
	}
	.prose > :global(h2) {
		margin-top: 56px;
		font-size: 28px;
		line-height: 1.3;
		font-weight: 600;
	}
	.prose > :global(h2 + p),
	.prose > :global(h2 + ul) {
		margin-top: 20px;
	}
	.prose > :global(ul) {
		padding-left: 22px;
		font-size: 19px;
		line-height: 1.75;
	}
	.prose > :global(ul li) {
		margin-top: 10px;
	}
	.prose > :global(ul + p) {
		margin-top: 32px;
	}
	.prose > :global(p.placeholder) {
		color: var(--muted);
	}
	.prose :global(.pipeline) {
		margin-top: 24px;
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 8px;
	}
	.prose :global(.step) {
		flex: 1 1 180px;
		min-width: 0;
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 16px;
	}
	.prose :global(.step--gate) {
		border: 2px solid var(--ink);
		padding: 15px;
	}
	.prose :global(.step-who) {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}
	.prose :global(.step--agent .step-who) {
		color: var(--accent);
	}
	.prose :global(.step-what) {
		margin: 6px 0 0;
		font-size: 15px;
		line-height: 1.45;
		font-weight: 500;
	}
	.prose > :global(p.pipeline-note) {
		margin-top: 12px;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: normal;
		color: var(--muted);
	}
	.prose :global(.permissions) {
		margin-top: 24px;
		border-bottom: 1px solid var(--rule);
	}
	.prose :global(.permissions > div) {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 24px;
		padding: 16px 0;
		border-top: 1px solid var(--rule);
	}
	.prose :global(.permissions dt) {
		width: 96px;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--accent);
	}
	.prose :global(.permissions .never dt) {
		color: var(--danger);
	}
	.prose :global(.permissions dd) {
		margin: 0;
		flex: 1 1 320px;
		font-size: 17px;
		line-height: 1.6;
	}

	.next {
		margin-top: 64px;
		padding-top: 24px;
		border-top: 1px solid var(--rule);
	}
	.next a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		margin-top: 8px;
		font-size: 20px;
		font-weight: 500;
		text-decoration: none;
	}
	.strip {
		margin-top: 48px;
		padding: 28px;
		gap: 16px;
	}
	.strip p {
		font-size: 19px;
		line-height: 1.45;
		max-width: 26rem;
	}
	.strip .btn {
		padding: 0 20px;
	}
</style>

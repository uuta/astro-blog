---
import { siGithub, siX, siZenn } from 'simple-icons';
import { toolColor } from '../lib/tools';

// The only way to reach the owner: no form, no backend.
// Colors follow the tool icons: near-black logos use the text color, and Zenn's blue
// gets a darker shade of the same hue in light mode to keep 3:1.
const links = [
	{ name: 'X', href: 'https://x.com/xXxuutaxXx', icon: siX, ink: true },
	{ name: 'GitHub', href: 'https://github.com/uuta', icon: siGithub, ink: true },
	{ name: 'Zenn', href: 'https://zenn.dev/yutti', icon: siZenn, light: '#0091FF' },
];
---

<ul class="contact-icons">
	{
		links.map((link) => (
			<li>
				{/* The title is both the accessible name and the hover tooltip. */}
				<a href={link.href} title={link.name} style={`color: ${toolColor(link)}`}>
					<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
						<path d={link.icon.path} fill="currentColor" />
					</svg>
				</a>
			</li>
		))
	}
</ul>

<style>
	.contact-icons {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 1px solid var(--rule);
		border-radius: 10px;
		background: var(--card);
		transition:
			border-color 0.15s,
			transform 0.15s;
	}
	a:hover {
		border-color: var(--line);
		transform: translateY(-2px);
	}
	svg {
		display: block;
	}
	@media (prefers-reduced-motion: reduce) {
		a {
			transition: none;
		}
		a:hover {
			transform: none;
		}
	}
</style>

---
import Base from '../../layouts/Base.astro';
import Hero from './Hero.astro';
import Focus from './Focus.astro';
import Work from './Work.astro';
import Writing from './Writing.astro';
import Services from './Services.astro';
import { home } from '../../i18n/home';
import { localeUrl, otherLang, type Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { meta } = home[lang];
---

<Base
	lang={lang}
	title={meta.title}
	description={meta.description}
	counterpart={{ href: localeUrl(otherLang(lang)), translated: true }}
	xDefault="/"
>
	<main>
		<Hero lang={lang} />
		<Focus lang={lang} />
		<Work lang={lang} />
		<Writing lang={lang} />
		<Services lang={lang} />
	</main>
</Base>

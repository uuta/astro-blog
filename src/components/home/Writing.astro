---
import SectionHead from './SectionHead.astro';
import { home } from '../../i18n/home';
import type { Lang } from '../../i18n/ui';
import Icon from '../Icon.astro';
import { keyedPostUrl, postsUrl } from '../../lib/writing';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang].writing;
const rows = await Promise.all(
	t.rows.map(async (row) => ({ ...row, href: row.post ? await keyedPostUrl(row.post, lang) : '#' })),
);
---

<section id="writing" class="section">
	<div class="wrap section-inner">
		<SectionHead kicker={t.kicker} title={t.title} tight />
		<ul>
			{
				rows.map((row) => (
					<li>
						<a href={row.href}>
							<span class="date mono">{row.date}</span>
							<span class="title">{row.title}</span>
						</a>
					</li>
				))
			}
		</ul>
		<a class="accent-link all" href={postsUrl(lang)}>{t.all}<Icon name="arrow-right" /></a>
	</div>
</section>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--rule);
	}
	li {
		border-top: 1px solid var(--rule);
	}
	a {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 32px;
		padding: 24px 0;
		text-decoration: none;
	}
	.date {
		width: 120px;
		font-size: 14px;
		color: var(--muted);
	}
	.title {
		flex: 1 1 420px;
		font-size: 22px;
		font-weight: 500;
		line-height: 1.35;
	}
	.all {
		margin-top: 24px;
	}
	.title:lang(ja) {
		font-size: 20px;
		line-height: 1.6;
	}
</style>

<style>
	.hero-figure {
		flex: 1.35 1 520px;
		min-width: 0;
		margin: 0;
	}
	.hero-canvas {
		position: relative;
		width: 100%;
		aspect-ratio: 5 / 4;
		background: var(--soft);
		border: 1px solid var(--rule);
		border-radius: 6px;
		overflow: hidden;
	}
	.hero-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.node {
		position: absolute;
		transform: translateX(-50%);
		text-align: center;
		white-space: nowrap;
		pointer-events: none;
	}
	.node-name {
		font-size: 12px;
		font-weight: 500;
		line-height: 1.2;
	}
	.node-sub {
		margin-top: 2px;
		font-size: 11px;
		line-height: 1.3;
		color: var(--muted);
	}
	.fix {
		position: absolute;
		left: 49%;
		top: 15%;
		transform: translateX(-50%);
		white-space: nowrap;
		pointer-events: none;
		font-size: 11px;
		line-height: 1.3;
		color: var(--muted);
	}
	figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-top: 14px;
		font-size: 12px;
		line-height: 1.5;
		color: var(--muted);
	}
	.legend {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.swatch {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.swatch--accent {
		background: var(--accent);
	}
	.swatch--ink {
		background: var(--ink);
	}
</style>

<style is:global>
	.hero-art .dot{fill:none;stroke-width:14;stroke-linecap:round;stroke-dasharray:0.01 199.99;opacity:0}
	.hero-art .hid{opacity:0}
	.hero-art .tl,.hero-art .ring{transform-box:fill-box;transform-origin:0 50%}

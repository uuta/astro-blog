---
import type { Lang } from '../../i18n/ui';
import { home } from '../../i18n/home';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { label, nodes, fixRequested, legend } = home[lang].hero.art;

// Card frames [x, y, width] in the 1000 × 800 drawing, all 150 tall. The top row runs
// left to right; the bottom row comes back right to left after review and ends with
// distribution, under analysis.
const cards = {
	analysis: [100, 160, 220],
	manager: [390, 160, 220],
	engineer: [680, 160, 220],
	reviewers: [680, 470, 220],
	pr: [450, 470, 160],
	distribution: [100, 470, 170],
} as const;
const at = (card: keyof typeof cards) => `translate(${cards[card][0]} ${cards[card][1]})`;
// Reviewer chips; the lit ones are the reviewers this change picked.
const chips = [44, 88, 132, 176];
const picked = [44, 132];
---

<figure class="hero-figure">
	<div class="hero-canvas">
		<svg class="hero-art" viewBox="0 0 1000 800" role="img" aria-label={label}>
			<defs>
				<pattern id="hero-grid" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M0 0 H50 M0 0 V50" fill="none" stroke-width="1.5" style="stroke: var(--rule)"></path></pattern>
			</defs>
			<rect width="1000" height="800" fill="url(#hero-grid)"></rect>

			{/* Edges: analysis → manager → engineer ↓ reviewers → pull request → merged → distribution */}
			<g fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--line)">
				<path d="M320 235 H390"></path>
				<path d="M610 235 H680"></path>
				<path d="M830 310 V470"></path>
				<path d="M680 545 H610"></path>
				<path d="M450 545 H386"></path>
				<path d="M334 545 H270"></path>
				<path d="M381 229 L389 235 L381 241"></path>
				<path d="M671 229 L679 235 L671 241"></path>
				<path d="M824 461 L830 469 L836 461"></path>
				<path d="M619 539 L611 545 L619 551"></path>
				<path d="M395 539 L387 545 L395 551"></path>
				<path d="M279 539 L271 545 L279 551"></path>
			</g>
			{/* Fix loop: reviewers back to the engineer */}
			<path d="M750 470 V310" fill="none" stroke-width="2" stroke-dasharray="8 7" style="stroke: var(--field-line)"></path>
			<path d="M744 319 L750 311 L756 319" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--field-line)"></path>

			{
				Object.values(cards).map(([x, y, w]) => (
					<g transform={`translate(${x} ${y})`}>
						<rect width={w} height="150" rx="6" stroke-width="1.5" style="fill: var(--card); stroke: var(--field-line)" />
						<path d={`M0 22 V6 Q0 0 6 0 H${w - 6} Q${w} 0 ${w} 6 V22 Z`} style="fill: var(--svg-2)" />
						<path d={`M0 22 H${w}`} stroke-width="1.5" style="stroke: var(--field-line)" />
					</g>
				))
			}

			{/* Analysis: market, infrastructure, cost, checked one by one */}
			<g transform={at('analysis')}>
				<circle cx="13" cy="11" r="4" fill="none" stroke-width="1.5" style="stroke: var(--field-line)"></circle>
				<path d="M16 14 L19.5 17.5" stroke-width="1.5" stroke-linecap="round" style="stroke: var(--field-line)"></path>
				<rect x="26" y="8" width="60" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<g style="fill: var(--field-line)">
					<rect x="12" y="47" width="3" height="6"></rect>
					<rect x="17" y="44" width="3" height="9"></rect>
					<rect x="22" y="41" width="3" height="12"></rect>
					<rect x="11" y="76" width="15" height="5" rx="1"></rect>
					<rect x="11" y="83" width="15" height="5" rx="1"></rect>
				</g>
				<circle cx="18.5" cy="116" r="6.5" fill="none" stroke-width="1.5" style="stroke: var(--field-line)"></circle>
				<path d="M18.5 112.5 V119.5" stroke-width="1.5" style="stroke: var(--field-line)"></path>
				<rect x="36" y="45" width="92" height="6" rx="3" style="fill: var(--line)"></rect>
				<rect x="36" y="79" width="70" height="6" rx="3" style="fill: var(--line)"></rect>
				<rect x="36" y="113" width="80" height="6" rx="3" style="fill: var(--line)"></rect>
				<rect x="150" y="44" width="56" height="8" rx="4" style="fill: var(--svg-2)"></rect>
				<rect x="150" y="78" width="56" height="8" rx="4" style="fill: var(--svg-2)"></rect>
				<rect x="150" y="112" width="56" height="8" rx="4" style="fill: var(--svg-2)"></rect>
				<rect class="hid rm a-p1" x="150" y="44" width="56" height="8" rx="4" style="fill: var(--accent)"></rect>
				<rect class="hid rm a-p2" x="150" y="78" width="56" height="8" rx="4" style="fill: var(--accent)"></rect>
				<rect class="hid rm a-p3" x="150" y="112" width="56" height="8" rx="4" style="fill: var(--accent)"></rect>
			</g>

			{/* Manager: picks the top task and hands it on */}
			<g transform={at('manager')}>
				<g style="fill: var(--dashed)"><circle cx="12" cy="11" r="3"></circle><circle cx="22" cy="11" r="3"></circle><circle cx="32" cy="11" r="3"></circle></g>
				<g class="hid rm a-mhl">
					<rect x="6" y="40" width="208" height="20" rx="4" style="fill: var(--accent)" fill-opacity="0.14"></rect>
					<circle cx="20" cy="50" r="5" style="fill: var(--accent)"></circle>
					<rect x="158" y="45" width="46" height="10" rx="5" style="fill: var(--accent)"></rect>
					<path d="M173 50 H187 M183 46.5 L187 50 L183 53.5" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--on-accent)"></path>
				</g>
				<g fill="none" stroke-width="1.5" style="stroke: var(--ok)"><circle cx="20" cy="50" r="5"></circle><circle cx="20" cy="80" r="5"></circle><circle cx="20" cy="110" r="5"></circle></g>
				<g style="fill: var(--line)">
					<rect x="32" y="46.5" width="96" height="7" rx="3.5"></rect>
					<rect x="32" y="76.5" width="74" height="7" rx="3.5"></rect>
					<rect x="32" y="106.5" width="86" height="7" rx="3.5"></rect>
				</g>
			</g>

			{/* Engineer: one worktree, code typed line by line, one line fixed after review */}
			<g transform={at('engineer')}>
				<g style="fill: var(--dashed)"><circle cx="12" cy="11" r="3"></circle><circle cx="22" cy="11" r="3"></circle><circle cx="32" cy="11" r="3"></circle></g>
				<rect x="156" y="7" width="52" height="8" rx="4" style="fill: var(--dashed)"></rect>
				<rect class="hid a-fix" x="6" y="79.5" width="208" height="16" rx="3" style="fill: var(--accent)" fill-opacity="0.16"></rect>
				<g class="tl a-l1"><rect x="14" y="30" width="16" height="7" rx="3.5" style="fill: var(--accent)"></rect><rect x="35" y="30" width="52" height="7" rx="3.5" style="fill: var(--field-line)"></rect><rect x="92" y="30" width="22" height="7" rx="3.5" style="fill: var(--dashed)"></rect></g>
				<g class="tl a-l2"><rect x="28" y="48" width="18" height="7" rx="3.5" style="fill: var(--dashed)"></rect><rect x="51" y="48" width="64" height="7" rx="3.5" style="fill: var(--field-line)"></rect></g>
				<g class="tl a-l3"><rect x="28" y="66" width="22" height="7" rx="3.5" style="fill: var(--accent)"></rect><rect x="55" y="66" width="40" height="7" rx="3.5" style="fill: var(--field-line)"></rect><rect x="100" y="66" width="36" height="7" rx="3.5" style="fill: var(--danger)"></rect></g>
				<g class="tl a-l4"><rect x="28" y="84" width="72" height="7" rx="3.5" style="fill: var(--field-line)"></rect><rect x="105" y="84" width="14" height="7" rx="3.5" style="fill: var(--dashed)"></rect></g>
				<g class="tl a-l5"><rect x="42" y="102" width="50" height="7" rx="3.5" style="fill: var(--field-line)"></rect><rect x="97" y="102" width="28" height="7" rx="3.5" style="fill: var(--accent)"></rect></g>
				<g class="tl a-l6"><rect x="14" y="120" width="10" height="7" rx="3.5" style="fill: var(--dashed)"></rect></g>
				<rect class="blink" x="30" y="118" width="6" height="11" style="fill: var(--ink)"></rect>
			</g>

			{/* Reviewers: only the ones this change needs light up; they request a fix, then approve */}
			<g transform={at('reviewers')}>
				<rect x="10" y="8" width="46" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect x="62" y="8" width="26" height="6" rx="3" style="fill: var(--line)"></rect>
				{
					chips.map((cx) => (
						<g>
							<circle cx={cx} cy="50" r="15" stroke-width="1.5" style="fill: var(--card); stroke: var(--line)" />
							<circle cx={cx} cy="46" r="4.5" style="fill: var(--dashed)" />
							<path d={`M${cx - 8} 60 a8 7 0 0 1 16 0`} style="fill: var(--dashed)" />
						</g>
					))
				}
				<g class="hid rm a-sel" fill="none" stroke-width="2.5" style="stroke: var(--accent)">
					{picked.map((cx) => <circle cx={cx} cy="50" r="15" />)}
				</g>
				<g class="hid rm a-ok">
					{
						picked.map((cx) => (
							<g>
								<circle cx={cx} cy="50" r="15" style="fill: var(--accent)" />
								<path d={`M${cx - 6} 50 l4 4 l8 -8.5`} fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--on-accent)" />
							</g>
						))
					}
				</g>
				<rect x="2" y="80" width="216" height="14" style="fill: var(--danger)" fill-opacity="0.12"></rect>
				<rect x="5" y="82" width="3" height="10" style="fill: var(--danger)"></rect>
				<rect x="18" y="84" width="70" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect x="2" y="100" width="216" height="14" style="fill: var(--accent)" fill-opacity="0.12"></rect>
				<rect x="5" y="102" width="3" height="10" style="fill: var(--accent)"></rect>
				<rect x="18" y="104" width="96" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect x="2" y="120" width="216" height="14" style="fill: var(--accent)" fill-opacity="0.12"></rect>
				<rect x="5" y="122" width="3" height="10" style="fill: var(--accent)"></rect>
				<rect x="18" y="124" width="58" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect class="hid a-cmt" x="1.5" y="78.5" width="217" height="17" rx="3" fill="none" stroke-width="1.5" style="stroke: var(--ink)"></rect>
			</g>

			{/* Pull request: checks pass one by one, then the merge button */}
			<g transform={at('pr')}>
				<g fill="none" stroke-width="1.5" style="stroke: var(--field-line)"><circle cx="11" cy="7" r="2.5"></circle><circle cx="11" cy="17" r="2.5"></circle><path d="M11 9.5 V14.5"></path><path d="M21 14.5 V9 Q21 5 17 5 H15"></path><circle cx="21" cy="17" r="2.5"></circle></g>
				<rect x="32" y="8" width="56" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect x="12" y="34" width="110" height="8" rx="4" style="fill: var(--field-line)"></rect>
				<g fill="none" stroke-width="1.5" style="stroke: var(--line)"><circle cx="18" cy="60" r="5.5"></circle><circle cx="18" cy="80" r="5.5"></circle><circle cx="18" cy="100" r="5.5"></circle></g>
				<g style="fill: var(--line)">
					<rect x="30" y="57" width="70" height="6" rx="3"></rect>
					<rect x="30" y="77" width="56" height="6" rx="3"></rect>
					<rect x="30" y="97" width="64" height="6" rx="3"></rect>
				</g>
				{
					[60, 80, 100].map((cy, i) => (
						<g class={`hid rm a-c${i + 1}`}>
							<circle cx="18" cy={cy} r="5.5" style="fill: var(--accent)" />
							<path d={`M15.4 ${cy + 0.2} l1.9 1.9 l3.4 -3.6`} fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--on-accent)" />
						</g>
					))
				}
				<rect x="12" y="118" width="136" height="22" rx="4" style="fill: var(--svg-2)"></rect>
				<rect class="hid rm a-mb" x="12" y="118" width="136" height="22" rx="4" style="fill: var(--accent)"></rect>
				<rect x="50" y="126" width="60" height="6" rx="3" style="fill: var(--card)"></rect>
			</g>

			{/* Merged, by me */}
			<circle class="hid ring a-ring" cx="360" cy="545" r="26" fill="none" stroke-width="2" style="stroke: var(--accent)"></circle>
			<circle cx="360" cy="545" r="26" style="fill: var(--inverse)"></circle>
			<g fill="none" stroke-width="2" stroke-linecap="round" style="stroke: var(--on-inverse)"><circle cx="352" cy="533" r="3.5"></circle><circle cx="352" cy="557" r="3.5"></circle><circle cx="369" cy="550" r="3.5"></circle><path d="M352 536.5 V553.5"></path><path d="M352 536.5 Q352 546 365.5 549"></path></g>

			{/* Distribution: agents make a video and a carousel, write the caption, and post it */}
			<g transform={at('distribution')}>
				<g fill="none" stroke-width="1.5" stroke-linecap="round" style="stroke: var(--field-line)"><path d="M9 7.5 A5 5 0 0 0 9 14.5"></path><path d="M17 7.5 A5 5 0 0 1 17 14.5"></path></g>
				<circle cx="13" cy="11" r="2" style="fill: var(--field-line)"></circle>
				<rect x="26" y="8" width="50" height="6" rx="3" style="fill: var(--field-line)"></rect>
				<rect x="12" y="32" width="52" height="104" rx="6" style="fill: var(--svg-2)"></rect>
				<path d="M32 74 L45 84 L32 94 Z" style="fill: var(--field-line)"></path>
				<g style="fill: var(--svg-2)">
					<rect x="76" y="64" width="24" height="24" rx="3"></rect>
					<rect x="105" y="64" width="24" height="24" rx="3"></rect>
					<rect x="134" y="64" width="24" height="24" rx="3"></rect>
				</g>
				<g class="hid rm a-vid">
					<rect x="12" y="32" width="52" height="104" rx="6" style="fill: var(--accent)" fill-opacity="0.16"></rect>
					<path d="M32 74 L45 84 L32 94 Z" style="fill: var(--accent)"></path>
					<g style="fill: var(--accent)" fill-opacity="0.16"><rect x="76" y="64" width="24" height="24" rx="3"></rect><rect x="105" y="64" width="24" height="24" rx="3"></rect><rect x="134" y="64" width="24" height="24" rx="3"></rect></g>
				</g>
				<g class="tl a-cap1"><rect x="76" y="34" width="80" height="6" rx="3" style="fill: var(--field-line)"></rect></g>
				<g class="tl a-cap2"><rect x="76" y="48" width="58" height="6" rx="3" style="fill: var(--line)"></rect></g>
				<rect x="76" y="112" width="82" height="22" rx="4" style="fill: var(--svg-2)"></rect>
				<rect class="hid rm a-post" x="76" y="112" width="82" height="22" rx="4" style="fill: var(--accent)"></rect>
				<rect x="95" y="120" width="44" height="6" rx="3" style="fill: var(--card)"></rect>
			</g>

			{/* Work moving along the edges; the ink dot is a fix request going back */}
			<g style="stroke: var(--accent)">
				<path class="dot a-d1" pathLength="100" d="M320 235 H390"></path>
				<path class="dot still a-d2" pathLength="100" d="M610 235 H680"></path>
				<path class="dot a-d3" pathLength="100" d="M830 310 V470"></path>
				<path class="dot a-d5" pathLength="100" d="M680 545 H610"></path>
				<path class="dot a-d6" pathLength="100" d="M450 545 H386"></path>
				<path class="dot a-d7" pathLength="100" d="M334 545 H270"></path>
			</g>
			<path class="dot still a-dfix" pathLength="100" d="M750 470 V310" style="stroke: var(--ink)"></path>
		</svg>

		{
			nodes.map((node) => (
				<div class:list={['node', { above: node.above }]} aria-hidden="true" style={`left: ${node.x}; top: ${node.y}`}>
					<div class="node-name">{node.name}</div>
					<div class="node-sub mono">{node.sub}</div>
				</div>
			))
		}
		<div class="fix mono" aria-hidden="true">{fixRequested}</div>
	</div>
	<figcaption class="mono">
		<span class="legend"><span class="swatch swatch--accent" aria-hidden="true"></span>{legend.forward}</span>
		<span class="legend"><span class="swatch swatch--ink" aria-hidden="true"></span>{legend.back}</span>
		<span>{legend.note}</span>
	</figcaption>
</figure>

<style>
	.hero-figure {
		flex: 1.35 1 520px;
		min-width: 0;
		margin: 0;
	}
	.hero-canvas {
		position: relative;
		width: 100%;
		aspect-ratio: 5 / 4;
		background: var(--soft);
		border: 1px solid var(--rule);
		border-radius: 6px;
		overflow: hidden;
	}
	.hero-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.node {
		position: absolute;
		/* Wide enough for one line on desktop; wraps on phones so neighbours don't collide. */
		width: max-content;
		max-width: 30%;
		transform: translateX(-50%);
		text-align: center;
		word-break: keep-all;
		pointer-events: none;
	}
	.node.above {
		transform: translate(-50%, -100%);
	}
	.node-name {
		font-size: 12px;
		font-weight: 500;
		line-height: 1.2;
	}
	.node-sub {
		margin-top: 2px;
		font-size: 11px;
		line-height: 1.3;
		color: var(--muted);
	}
	/* Sits just left of the dashed fix line (x = 750 of 1000), midway between the rows. */
	.fix {
		position: absolute;
		right: 26.5%;
		top: 48.75%;
		transform: translateY(-50%);
		white-space: nowrap;
		pointer-events: none;
		font-size: 11px;
		line-height: 1.3;
		color: var(--muted);
	}
	figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-top: 14px;
		font-size: 12px;
		line-height: 1.5;
		color: var(--muted);
	}
	.legend {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.swatch {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.swatch--accent {
		background: var(--accent);
	}
	.swatch--ink {
		background: var(--ink);
	}
</style>

<style is:global>
	/* One 12 s loop: analysis, manager, engineer, review with one fix round, pull request, merge, post. */
	.hero-art .dot{fill:none;stroke-width:14;stroke-linecap:round;stroke-dasharray:0.01 199.99;opacity:0}
	.hero-art .hid{opacity:0}
	.hero-art .tl{transform-box:fill-box;transform-origin:0 50%}
	.hero-art .ring{transform-box:fill-box;transform-origin:50% 50%}
	.hero-art .blink{animation:hero-blink 1s steps(1) infinite}@keyframes hero-blink{50%{opacity:0}}

	.hero-art .a-p1{animation:hero-p1 12s linear infinite}@keyframes hero-p1{0%,1%{opacity:0}1.8%,98.5%{opacity:1}99.3%,100%{opacity:0}}
	.hero-art .a-p2{animation:hero-p2 12s linear infinite}@keyframes hero-p2{0%,3.5%{opacity:0}4.3%,98.5%{opacity:1}99.3%,100%{opacity:0}}
	.hero-art .a-p3{animation:hero-p3 12s linear infinite}@keyframes hero-p3{0%,6%{opacity:0}6.8%,98.5%{opacity:1}99.3%,100%{opacity:0}}
	.hero-art .a-d1{animation:hero-d1 12s linear infinite}@keyframes hero-d1{0%,8%{opacity:0;stroke-dashoffset:0}8.1%{opacity:1;stroke-dashoffset:0}12%{opacity:1;stroke-dashoffset:-100}12.1%,100%{opacity:0;stroke-dashoffset:-100}}
	.hero-art .a-mhl{animation:hero-mhl 12s linear infinite}@keyframes hero-mhl{0%,12%{opacity:0}12.8%,98.5%{opacity:1}99.3%,100%{opacity:0}}
	.hero-art .a-d2{animation:hero-d2 12s linear infinite}@keyframes hero-d2{0%,15%{opacity:0;stroke-dashoffset:0}15.1%{opacity:1;stroke-dashoffset:0}19%{opacity:1;stroke-dashoffset:-100}19.1%,100%{opacity:0;stroke-dashoffset:-100}}
	.hero-art .a-l1{animation:hero-l1 12s linear infinite}@keyframes hero-l1{0%,20%{transform:scaleX(0)}21.5%,98.5%{transform:scaleX(1)}99%,100%{transform:scaleX(0)}}
	.hero-art .a-l2{animation:hero-l2 12s linear infinite}@keyframes hero-l2{0%,22%{transform:scaleX(0)}23.5%,98.5%{transform:scaleX(1)}99%,100%{transform:scaleX(0)}}
	.hero-art .a-l3{animation:hero-l3 12s linear infinite}@keyframes hero-l3{0%,24%{transform:scaleX(0)}25.5%,98.5%{transform:scaleX(1)}99%,100%{transform:scaleX(0)}}

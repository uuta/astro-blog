---
import ContactList from '../ContactList.astro';
import Icon from '../Icon.astro';
import { home } from '../../i18n/home';
import { localeUrl, type Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang].about;
---

<section id="about" class="section">
	<div class="wrap section-inner row">
		<div class="intro">
			<p class="kicker">{t.kicker}</p>
			<p class="lead">{t.lead}</p>
			<p class="body">{t.body}</p>
			<a class="profile-link" href={localeUrl(lang, 'profile/')}>{t.profileLink}<Icon name="arrow-right" /></a>
		</div>
		<div id="contact" class="contact">
			<p class="kicker kicker--muted">{t.contact}</p>
			<ContactList />
		</div>
	</div>
</section>

<style>
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 48px;
	}
	.intro {
		flex: 1 1 520px;
		min-width: 0;
	}
	.intro .kicker {
		margin-bottom: 20px;
	}
	.lead {
		margin: 0;
		font-size: 20px;
		line-height: 1.65;
	}
	.lead:lang(ja) {
		font-size: 19px;
		line-height: 1.85;
	}
	.body {
		margin: 20px 0 0;
		font-size: 18px;
		line-height: 1.7;
		color: var(--body);
	}
	.body:lang(ja) {
		font-size: 17px;
		line-height: 1.9;
	}
	.profile-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
		padding: 12px 0;
		font-size: 16px;
		font-weight: 500;
	}
	.contact {
		flex: 1 1 320px;
		min-width: 0;
	}
	.contact .kicker {
		margin-bottom: 12px;
	}
</style>

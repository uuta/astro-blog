---
import { home } from '../../i18n/home';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang].about;
---

<section id="about" class="section">
	<div class="wrap section-inner row">
		<div class="intro">
			<p class="kicker">{t.kicker}</p>
			<p class="lead">{t.lead}</p>
			<p class="body">{t.body}</p>
		</div>
		<div class="calls">
			<p class="meta-label">{t.callsTitle}</p>
			{/* Solid dots are my calls; the dashed line between two of them is the agents' work. */}
			<ol class="track">
				{
					t.calls.map((call) => (
						<li>
							<p class="call">{call.title}</p>
							<p class="sub">{call.sub}</p>
							{call.handoff && <p class="handoff mono">{call.handoff}</p>}
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 56px 72px;
	}
	.intro {
		flex: 1 1 520px;
		min-width: 0;
	}
	.intro .kicker {
		margin-bottom: 20px;
	}
	.lead {
		margin: 0;
		font-size: 24px;
		line-height: 1.5;
		font-weight: 500;
		letter-spacing: -0.005em;
	}
	.lead:lang(ja) {
		font-size: 21px;
		line-height: 1.8;
		letter-spacing: normal;
	}
	.body {
		margin: 24px 0 0;
		font-size: 18px;
		line-height: 1.7;
		color: var(--body);
	}
	.body:lang(ja) {
		font-size: 17px;
		line-height: 1.9;
	}
	.calls {
		flex: 1 1 340px;
		min-width: 0;
	}
	.track {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
	}
	.track li {
		position: relative;
		padding-left: 40px;
	}
	.track li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 6px;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent);
	}
	.track li:not(:last-child)::after {
		content: '';
		position: absolute;
		left: 7px;
		top: 36px;
		bottom: 10px;
		border-left: 2px dashed var(--line);
	}
	.call {
		margin: 0;
		font-size: 20px;
		line-height: 1.4;
		font-weight: 600;
	}
	.sub {
		margin: 4px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
	}
	.handoff {
		margin: 0;
		padding: 22px 0 30px;
		font-size: 13px;
		color: var(--muted);
	}
</style>

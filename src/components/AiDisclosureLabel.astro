---
import type { Lang } from '../i18n/ui';
import type { Post } from '../lib/writing';

type Level = Post['data']['aiDisclosure'];

interface Props {
	lang: Lang;
	level: Level;
}

// One label per level of the W3C AI Content Disclosure proposal. The title is the hover
// explanation; the icons are 16×16 strokes like Icon.astro.
const labels: Record<Lang, Record<Level, { text: string; title: string }>> = {
	en: {
		none: { text: 'Human-written', title: 'Written by a person, without AI.' },
		'ai-assisted': { text: 'AI-assisted', title: 'Written with AI, and checked by a person.' },
		'ai-generated': { text: 'AI-generated', title: 'Generated by AI.' },
		autonomous: { text: 'AI-autonomous', title: 'Generated by an AI agent on its own.' },
	},
	ja: {
		none: { text: '人が執筆', title: 'AIを使わずに人が書きました。' },
		'ai-assisted': { text: 'AI支援', title: 'AIを使って書き、人が確認しました。' },
		'ai-generated': { text: 'AI生成', title: 'AIが生成しました。' },
		autonomous: { text: 'AI自律生成', title: 'AIエージェントが自律的に生成しました。' },
	},
};

const icons: Record<Level, string> = {
	// A pen.
	none: 'M10.5 2.5l3 3L6 13H3v-3l7.5-7.5zM9 4l3 3',
	// A sparkle.
	'ai-assisted': 'M8 2l1.5 3.5L13 7l-3.5 1.5L8 12l-1.5-3.5L3 7l3.5-1.5zM12.5 11.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z',
	'ai-generated': 'M8 2l1.5 3.5L13 7l-3.5 1.5L8 12l-1.5-3.5L3 7l3.5-1.5zM8 5.5v3M6.5 7h3',
	autonomous: 'M8 2l1.5 3.5L13 7l-3.5 1.5L8 12l-1.5-3.5L3 7l3.5-1.5zM2 14h12',
};

const { lang, level } = Astro.props;
const { text, title } = labels[lang][level];
---

<span class:list={['ai-label', { 'ai-label--ai': level !== 'none' }]} title={title}>
	<svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icons[level]}></path></svg>
	{text}
</span>

<style>
	.ai-label {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 12px;
		line-height: 1.4;
		color: var(--muted);
		white-space: nowrap;
	}
	.ai-label--ai {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
	.ai-label--ai svg {
		color: var(--accent);
	}
</style>

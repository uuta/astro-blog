---
import Base from '../layouts/Base.astro';
import ContactList from './ContactList.astro';
import { profile } from '../i18n/profile';
import { localeUrl, otherLang, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = profile[lang];
---

<Base
	lang={lang}
	title={t.meta.title}
	description={t.meta.description}
	counterpart={{ href: localeUrl(otherLang(lang), 'profile/'), translated: true }}
	current="profile"
>
	<main class="wrap page">
		<p class="kicker">{t.kicker}</p>
		<div class="top">
			<div class="intro">
				<h1 class="page-title">uuta</h1>
				<p class="lead">{t.lead}</p>
				<p class="background">{t.background}</p>
				<div class="btn-row">
					{/* [RÉSUMÉ LINK]: placeholder until the PDF exists. */}
					<a class="btn btn--primary" href="#">{t.resume}</a>
					<a class="btn btn--secondary" href="#contact">{t.contact}</a>
				</div>
			</div>
			<div class="side">
				<div class="photo mono">{t.photo}</div>
				<div class="contact">
					<ContactList id="contact" />
				</div>
			</div>
		</div>

		<section class="experience">
			<h2>{t.experienceTitle}</h2>
			<ul class="rows">
				{
					t.experience.map((item) => (
						<li class="row">
							<span class="years mono">{item.years}</span>
							<div class="row-body">
								<p class="role">{item.role}</p>
								<p class="desc">{item.body}</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section class="skills">
			<h2>{t.skillsTitle}</h2>
			<dl class="rows">
				{
					t.skills.map((skill) => (
						<div class="skill">
							<dt>{skill.name}</dt>
							<dd class="desc">{skill.body}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</main>
</Base>

<style>
	.page {
		padding-top: 80px;
		padding-bottom: 96px;
	}
	.page > .kicker {
		margin-bottom: 20px;
	}
	.top {
		display: flex;
		flex-wrap: wrap;
		gap: 48px 56px;
		align-items: flex-start;
	}
	.intro {
		flex: 999 1 520px;
		min-width: 0;
	}
	.lead {
		margin: 16px 0 0;
		font-size: 21px;
		line-height: 1.55;
		font-weight: 500;
		max-width: 36rem;
	}
	.lead:lang(ja) {
		font-size: 20px;
		line-height: 1.75;
	}
	.background {
		margin: 20px 0 0;
		font-size: 18px;
		line-height: 1.7;
		color: var(--body);
		max-width: 40rem;
	}
	.background:lang(ja) {
		font-size: 17px;
		line-height: 1.9;
	}
	.btn-row {
		margin-top: 32px;
	}
	.side {
		flex: 1 1 280px;
		min-width: 0;
		max-width: 360px;
	}
	.photo {
		aspect-ratio: 1;
		border: 1px dashed var(--dashed);
		border-radius: 6px;
		background: var(--soft);
		display: grid;
		place-items: center;
		font-size: 14px;
		color: var(--muted);
	}
	.contact {
		margin-top: 24px;
	}
	.experience {
		margin-top: 88px;
	}
	.skills {
		margin-top: 72px;
	}
	h2 {
		margin: 0 0 20px;
		font-size: 26px;
		line-height: 1.35;
		font-weight: 600;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--rule);
	}
	.row {
		border-top: 1px solid var(--rule);
		display: flex;
		flex-wrap: wrap;
		gap: 8px 32px;
		padding: 24px 0;
	}
	.years {
		width: 160px;
		font-size: 14px;
		color: var(--muted);
		padding-top: 3px;
	}
	.row-body {
		flex: 1 1 420px;
		min-width: 0;
	}
	.role {
		margin: 0;
		font-size: 19px;
		line-height: 1.45;
		font-weight: 500;
	}
	.desc {
		font-size: 16px;
		line-height: 1.65;
		color: var(--body);
	}
	.desc:lang(ja) {
		line-height: 1.85;
	}
	p.desc {
		margin: 6px 0 0;
	}
	.skill {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 32px;
		padding: 18px 0;
		border-top: 1px solid var(--rule);
	}
	dt {
		width: 160px;
		font-weight: 500;
	}
	dd {
		margin: 0;
		flex: 1 1 420px;
		min-width: 0;
	}
</style>
